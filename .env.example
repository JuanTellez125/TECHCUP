# Copia este archivo como .env y completa los valores reales.
# El archivo .env NUNCA debe subirse al repositorio.

# Base de datos PostgreSQL
TECHCUP_DB_URL=jdbc:postgresql://localhost:5432/techcup
TECHCUP_DB_USERNAME=postgres
TECHCUP_DB_PASSWORD=tu_password_aqui

# JWT — genera una clave Base64 de al menos 256 bits
# Ejemplo (Linux/Mac): openssl rand -base64 32
JWT_SECRET=tu_clave_base64_aqui
JWT_EXPIRATION=3600000

# CORS — orígenes permitidos separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173
