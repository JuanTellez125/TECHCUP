# ─── Copia este archivo como .env y completa los valores ────────────────────
# NUNCA subas el archivo .env al repositorio.

# ─── Base de datos ───────────────────────────────────────────────────────────
# Para desarrollo local con Docker Compose, DB_URL se construye automáticamente.
# Solo necesitas estas tres variables:
TECHCUP_DB_NAME=techcup
TECHCUP_DB_USERNAME=postgres
TECHCUP_DB_PASSWORD=tu_password_aqui

# Para conexión directa sin Docker (IntelliJ corriendo la app directamente):
TECHCUP_DB_URL=jdbc:postgresql://localhost:5432/techcup

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Genera una clave con: openssl rand -base64 32
JWT_SECRET=tu_clave_base64_aqui
JWT_EXPIRATION=3600000

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── Perfil de Spring ────────────────────────────────────────────────────────
# Valores posibles: local | qa | prod
SPRING_PROFILES_ACTIVE=local

# ─── SSL ─────────────────────────────────────────────────────────────────────
SSL_KEY_STORE_PASSWORD=tu_password_del_keystore

